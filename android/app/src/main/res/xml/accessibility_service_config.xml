<?xml version="1.0" encoding="utf-8"?>
<!--
    시스템에 "이 서비스가 무엇을 원하는지" 알리는 설정.
    - accessibilityEventTypes: 화면 전환, 화면 내용 변경, 클릭.
      내용 변경은 웹 페이지처럼 화면 전환 없이 내용만 바뀌는 경우를 잡기 위해 받는다 (서비스에서 0.5초 모아서 처리).
    - accessibilityFlags: flagReportViewIds = 노드의 리소스 id(com.app:id/next 등)를 받는다.
      숨은 노드까지 받는 flagIncludeNotImportantViews는 일단 끈다 (웹뷰 정보가 부족하면 #9에서 켜고 비교).
    - accessibilityFeedbackType: 우리는 소리·진동 대신 화면 표시를 하지만, 해당 값이 없어 일반(generic)으로 둔다.
    - notificationTimeout: 같은 종류 이벤트를 최소 100ms 간격으로 묶어 받는다.
    - canRetrieveWindowContent: 화면의 노드 트리(버튼 글자·위치)를 읽겠다는 선언.
    - description: 설정 화면에서 사용자가 읽는 설명. 무엇을 보는지 정직하게 적는다.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked"
    android:accessibilityFlags="flagReportViewIds"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description" />
