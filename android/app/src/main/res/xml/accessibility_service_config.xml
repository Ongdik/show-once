<?xml version="1.0" encoding="utf-8"?>
<!--
    시스템에 "이 서비스가 무엇을 원하는지" 알리는 설정.
    - accessibilityEventTypes: 화면 전환과 클릭만 받는다. 모든 이벤트를 받으면 스크롤만 해도 로그가 쏟아진다.
    - accessibilityFeedbackType: 우리는 소리·진동 대신 화면 표시를 하지만, 해당 값이 없어 일반(generic)으로 둔다.
    - notificationTimeout: 같은 종류 이벤트를 최소 100ms 간격으로 묶어 받는다.
    - canRetrieveWindowContent: 화면의 노드 트리(버튼 글자·위치)를 읽겠다는 선언. 다음 단계에서 쓴다.
    - description: 설정 화면에서 사용자가 읽는 설명. 무엇을 보는지 정직하게 적는다.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description" />
